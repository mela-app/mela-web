# Copy to .env (gitignored) and adjust. Nothing here is secret, but every
# address the player uses in development comes from this file - the code has
# no built-in ones.

# `npm run dev` / `npm run preview`: the API that /v1 and /socket.io are
# proxied to - mela-backend on this machine.
WEB_API_ORIGIN=http://localhost:3000

# The development page (/web/?stream=<live id>) plays without the share page,
# so it takes the app's identifiers from here - the same values as
# APP_URL_SCHEME and ANDROID_APP_PACKAGE_NAME in mela-backend's .env.
# Production builds never include them: there, the share page provides them.
VITE_APP_URL_SCHEME=gamblinglive
VITE_ANDROID_APP_PACKAGE_NAME=com.gamblinglive.app

# --- Docker (docker-compose.yml reads this file too) --------------------------
# `docker compose up -d --build` (the production image, locally): where the
# player listens on this machine (127.0.0.1 only). The admin console already
# takes 8080.
WEB_PORT=8081
